#include <stdio.h>

int main() {
    float hit, mem = 100, tlb = 10, eat;

    printf("Enter TLB Hit Ratio: ");
    scanf("%f", &hit);

    eat = hit * (tlb + mem) + (1 - hit) * (tlb + 2 * mem);

    printf("Without TLB = %.0f ns\n", 2 * mem);
    printf("With TLB (EAT) = %.1f ns", eat);

    return 0;
}
OUTPUT:
Enter TLB Hit Ratio: 0.8
Without TLB = 200 ns
With TLB (EAT) = 130.0 ns


