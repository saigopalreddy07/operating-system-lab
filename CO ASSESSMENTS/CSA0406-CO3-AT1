#include <stdio.h>
int main() {
    int pageTable[5] = {2, 4, 1, 7, 3};
    int page, offset, size = 100;

    printf("Enter Page Number: ");
    scanf("%d", &page);

    printf("Enter Offset: ");
    scanf("%d", &offset);

    if (page < 0 || page >= 5 || offset >= size)
        printf("Invalid Page Number or Offset");
    else {
        int physical = pageTable[page] * size + offset;
        printf("Frame Number = %d\n", pageTable[page]);
        printf("Physical Address = %d", physical);
    }

    return 0;
}
OUTPUT:
Enter Page Number: 2
Enter Offset: 45
Frame Number = 1
Physical Address = 145


