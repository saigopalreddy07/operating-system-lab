#include <stdio.h>

int main() {
    int pt[5], p, o, i;

    for(i = 0; i < 5; i++) {
        printf("Frame for Page %d: ", i);
        scanf("%d", &pt[i]);
    }

    printf("Page and Offset: ");
    scanf("%d%d", &p, &o);

    if(p >= 5 || o >= 100)
        printf("Invalid");
    else {
        printf("Page %d -> Frame %d\n", p, pt[p]);
        printf("Physical Address = %d", pt[p] * 100 + o);
    }

    return 0;
}

