  #include <stdio.h>

int main() {
    int total, size, method, start, i;

    printf("Total Blocks: ");
    scanf("%d", &total);

    printf("File Size (blocks): ");
    scanf("%d", &size);

    printf("Method (1-Contiguous 2-Linked 3-Indexed): ");
    scanf("%d", &method);

    if (size > total) {
        printf("Allocation not possible\n");
        return 0;
    }

    if (method == 1) {
        printf("Start Block: ");
        scanf("%d", &start);

        if (start + size > total)
            printf("Not enough contiguous space\n");
        else {
            printf("Allocated Blocks: ");
            for (i = start; i < start + size; i++)
                printf("%d ", i);
        }
    }
    else if (method == 2) {
        printf("Allocated Blocks (Linked): ");
        for (i = 0; i < size; i++)
            printf("%d ", i * 2);
    }
    else if (method == 3) {
        printf("Index Block: 0\n");
        printf("Allocated Blocks: ");
        for (i = 1; i <= size; i++)
            printf("%d ", i);
    }
    else
        printf("Invalid Method");

    return 0;
}
