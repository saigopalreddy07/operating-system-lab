  #include <stdio.h>

int main() {
    int n, b[50], req, i;

    printf("Enter total blocks: ");
    scanf("%d", &n);

    printf("Enter bitmap (0-Free 1-Allocated):\n");
    for(i=0;i<n;i++)
        scanf("%d",&b[i]);

    printf("Blocks required: ");
    scanf("%d",&req);

    printf("Allocated Blocks: ");
    for(i=0;i<n && req>0;i++){
        if(b[i]==0){
            b[i]=1;
            printf("%d ",i);
            req--;
        }
    }

    if(req>0)
        printf("\nAllocation not possible");

    printf("\nUpdated Bitmap:\n");
    for(i=0;i<n;i++)
        printf("%d ",b[i]);

    return 0;
}
