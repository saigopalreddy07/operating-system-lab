  #include <stdio.h>
#include <stdlib.h>

int main() {
    int n,i,head,req[20],seek=0;

    printf("Enter number of requests: ");
    scanf("%d",&n);

    printf("Enter requests: ");
    for(i=0;i<n;i++)
        scanf("%d",&req[i]);

    printf("Enter head position: ");
    scanf("%d",&head);

    printf("\nFCFS Order: ");
    for(i=0;i<n;i++){
        printf("%d ",req[i]);
        seek+=abs(head-req[i]);
        head=req[i];
    }

    printf("\nTotal Seek Time = %d\n",seek);
    return 0;
}
