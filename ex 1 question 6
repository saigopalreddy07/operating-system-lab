#include <stdio.h>

int main() {
    int pages[] = {1, 2, 3, 1, 4, 5};
    int frame[3] = {-1, -1, -1};
    int i, j, k = 0, hit, faults = 0;

    for (i = 0; i < 6; i++) {
        hit = 0;
        for (j = 0; j < 3; j++)
            if (frame[j] == pages[i])
                hit = 1;

        if (!hit) {
            frame[k] = pages[i];
            k = (k + 1) % 3;
            faults++;
        }
    }

    printf("Page Faults = %d\n", faults);
    return 0;
}
