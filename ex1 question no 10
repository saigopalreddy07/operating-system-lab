#include <stdio.h>

int main() {
    int bt[] = {5, 3, 8};   // Burst times
    int wt[3], sum = 0;

    wt[0] = 0;
    for (int i = 1; i < 3; i++)
        wt[i] = wt[i-1] + bt[i-1];

    for (int i = 0; i < 3; i++)
        sum += wt[i];

    printf("Average Waiting Time = %.2f\n", (float)sum / 3);

    return 0;
}
